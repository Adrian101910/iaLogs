# Ejecuta scripts/setup.ps1 o scripts/setup_env.py para generar secretos locales.
API_KEY=replace-with-a-random-key-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-random-hexadecimal-password
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_CONCURRENCY=1
OLLAMA_CONTEXT_TOKENS=16384
OLLAMA_OUTPUT_TOKENS=2048
MAX_REQUEST_BYTES=2097152
MAX_BATCH_EVENTS=500
MAX_MESSAGE_CHARS=16384
MAX_ANALYSIS_EVENTS=50
MAX_ANALYSIS_INPUT_BYTES=10000
MAX_MODEL_RESPONSE_BYTES=65536
